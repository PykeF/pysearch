# Copy to .env for local overrides. All settings are optional; the values shown
# here are the built-in defaults. There are no secrets, so nothing in this file
# is sensitive.

PYSEARCH_APP_NAME=pysearch
PYSEARCH_ENVIRONMENT=local
PYSEARCH_LOG_LEVEL=INFO

# SQLite database holding this node's authoritative documents. Parent
# directories are created on startup. One database per process, never shared.
PYSEARCH_STORAGE_PATH=pysearch.db

# Node role: single | shard | coordinator. A "single" node is a complete
# standalone search engine and needs none of the settings below.
PYSEARCH_NODE_ROLE=single

# Cluster topology. Fixed for the life of a cluster: routing is modulo the
# shard count, so changing it moves nearly every document.
# PYSEARCH_SHARD_COUNT=3

# Required on a shard, and must be in [0, PYSEARCH_SHARD_COUNT).
# PYSEARCH_SHARD_ID=0

# Required on a coordinator: one URL per shard, positionally indexed by shard id.
# PYSEARCH_SHARD_URLS=http://shard-0:8000,http://shard-1:8000,http://shard-2:8000

# Inter-node timeouts, in seconds. Every shard request is bounded by these.
# PYSEARCH_CONNECT_TIMEOUT=1.0
# PYSEARCH_REQUEST_TIMEOUT=2.0
