# Copy to .env for local overrides. All settings are optional; the values shown
# here are the built-in defaults. There are no secrets, so nothing in this file
# is sensitive.

PYSEARCH_APP_NAME=pysearch
PYSEARCH_ENVIRONMENT=local
PYSEARCH_LOG_LEVEL=INFO

# SQLite database holding this node's authoritative documents. Parent
# directories are created on startup. One database per process, never shared.
PYSEARCH_STORAGE_PATH=pysearch.db

# Node role: single | shard | coordinator. A "single" node is a complete
# standalone search engine and needs none of the settings below.
PYSEARCH_NODE_ROLE=single


# --- Semantic retrieval -----------------------------------------------------
# Off by default: left off, no node loads a model and every path behaves as it
# did before semantic search existed. Requires the "semantic" extra
# (`uv sync --extra semantic`); the first start downloads the model (~30 MB).
# PYSEARCH_SEMANTIC_ENABLED=false

# The embedding model, pinned to an exact revision rather than a branch, because
# a repository can move while keeping its name. Every copy that serves the same
# queries must agree on both. There is deliberately no vector-dimension setting:
# it is a property of the model, discovered when it loads.
# PYSEARCH_EMBEDDING_MODEL=minishlab/potion-base-8M
# PYSEARCH_EMBEDDING_MODEL_REVISION=bf8b056651a2c21b8d2565580b8569da283cab23


# --- Cluster topology -------------------------------------------------------
# Fixed for the life of a cluster: routing is modulo the shard count, so
# changing it moves nearly every document.
# PYSEARCH_SHARD_COUNT=3

# Required on a shard, and must be in [0, PYSEARCH_SHARD_COUNT).
# PYSEARCH_SHARD_ID=0

# Required on a coordinator: one URL per shard, positionally indexed by shard id.
# PYSEARCH_SHARD_URLS=http://shard-0:8000,http://shard-1:8000,http://shard-2:8000

# Stable name for this physical node, used in logs and cluster status.
# PYSEARCH_NODE_ID=shard-0-primary


# --- Replication ------------------------------------------------------------
# Whether this shard node is the writable copy or a replica of one. Roles are
# static: a replica has no write path, so two writable primaries cannot arise.
# PYSEARCH_REPLICA_ROLE=primary

# Replica base URLs. On a shard primary: its own replicas, comma-separated.
#   PYSEARCH_REPLICA_URLS=http://shard-0-replica:8000
# On a coordinator: ";" separates logical shards, "," separates replicas within
# one, positionally indexed by shard id.
#   PYSEARCH_REPLICA_URLS=http://shard-0-replica:8000;http://shard-1-replica:8000
# Empty means replication factor 1.

# Required on a replica, so it can verify synchronization and resynchronize. A
# replica that cannot reach its primary correctly refuses to serve.
# PYSEARCH_PRIMARY_URL=http://shard-0-primary:8000


# --- Timeouts, in seconds ---------------------------------------------------
# Every inter-node request is bounded, so an unresponsive node cannot hang a
# query.
# PYSEARCH_CONNECT_TIMEOUT=1.0
# PYSEARCH_REQUEST_TIMEOUT=2.0
# PYSEARCH_REPLICATION_TIMEOUT=2.0
