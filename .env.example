# Copy to .env for local overrides. All settings are optional; the values shown
# here are the built-in defaults. There are no secrets, so nothing in this file
# is sensitive.

PYSEARCH_APP_NAME=pysearch
PYSEARCH_ENVIRONMENT=local
PYSEARCH_LOG_LEVEL=INFO

# SQLite database holding the authoritative document corpus. Parent directories
# are created on startup. Use one database per process.
PYSEARCH_STORAGE_PATH=pysearch.db
