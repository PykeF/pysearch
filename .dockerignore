# Keep the build context to what the image actually needs: the package, its
# dependency manifests, and the readme the build backend reads.
.git/
.github/
.venv/
venv/

__pycache__/
*.py[cod]

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

tests/
scripts/
docs/

# Local databases must never be baked into an image.
*.db
*.db-journal
*.db-wal
*.db-shm

.env
.env.*
!.env.example

.idea/
.vscode/
.DS_Store

Dockerfile
docker-compose.yml
.dockerignore
